<!doctype html>
<html lang="es">
    <head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    </head>

    <body>
    <main>
        <h1>{{title}}</h1>
        <p>
        This page has controlled resources to test different testing systems.
        </p>
        <section>
            <h2>Spelling fixtures</h2>
            {{#each scenario.spelling}}
            <h3>{{label}}</h3>
            <p>
                {{text}}
            </p>
            {{/each}}
        </section>
        <section>
            <h2>Links Fixtures</h2>
            <ul>
                {{#each scenario.links}}
                    <li>
                        <a href="{{href}}">
                            {{label}}
                        </a>
                    </li>
                {{/each}}
            </ul>
        </section>
        <section>
            <h2>Image fixtures</h2>
                {{#each scenario.images}}
                <article>
                    <h3>{{label}}</h2>
                    <img
                    src="{{src}}"
                    alt="{{alt}}"
                    width="320"
                    height="180"
                    >
                </article>
                {{/each}}
        </section>
    </main>
    </body>
</html>