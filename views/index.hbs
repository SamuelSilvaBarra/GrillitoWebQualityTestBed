<!doctype html>
<html lang="es">
    <head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    </head>

    <body>
    <main>
    <form action="/demo" method="GET">

        <h1>{{title}}</h1>
        <p>
        This page has controlled resources to test different testing systems.
        </p>
        
        <section>
        <h2>Preset Scenarios</h2>
        <p>
            Run a predefined scenario.
        </p>

        {{#each presets}}
            <a href="{{href}}">
                {{label}}
            </a>
        {{/each}}
        </section>

        <fieldset>
            <legend>Spelling</legend>
            {{#each options.spelling}}
            <label>
                <input
                    type="checkbox"
                    name="spelling"
                    value="{{variant}}"
                >
                {{label}}
            </label>
            {{/each}}
        </fieldset>

        <fieldset>
            <legend>Links</legend>
            {{#each options.links}}
            <label>
                <input
                    type="checkbox"
                    name="links"
                    value="{{variant}}"
                >
                {{label}}
            </label>
            {{/each}}
        </fieldset>


        <fieldset>
            <legend>Images</legend>
            {{#each options.images}}
            <label>
                <input
                    type="checkbox"
                    name="images"
                    value="{{variant}}"
                >
                {{label}}
            </label>
            {{/each}}
        </fieldset>

        <fieldset>
            <legend>Videos</legend>
            {{#each options.videos}}
            <label>
                <input
                    type="checkbox"
                    name="videos"
                    value="{{variant}}"
                >
                {{label}}
            </label>
            {{/each}}
        </fieldset>

        <fieldset>
            <legend>PDFs</legend>
            {{#each options.pdfs}}
            <label>
                <input
                    type="checkbox"
                    name="pdfs"
                    value="{{variant}}"
                >
                {{label}}
            </label>
            {{/each}}
        </fieldset>

        <button type="submit">
            Generate scenario
        </button>

    </form>
    </main>
    </body>
</html>